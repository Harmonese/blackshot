{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (Debug)",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "-project", "Blackshot.xcodeproj",
        "-scheme", "Blackshot",
        "-configuration", "Debug",
        "build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$xcodebuild"
    },
    {
      "label": "Build (Release)",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "-project", "Blackshot.xcodeproj",
        "-scheme", "Blackshot",
        "-configuration", "Release",
        "build"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$xcodebuild"
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "-project", "Blackshot.xcodeproj",
        "-scheme", "Blackshot",
        "clean"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Clean + Build (Debug)",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "-project", "Blackshot.xcodeproj",
        "-scheme", "Blackshot",
        "-configuration", "Debug",
        "clean", "build"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": "$xcodebuild"
    }
  ]
}
